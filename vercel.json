{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist-demo",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/playground.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,src/**,dist/**,dist-demo/**,tests/**,deploy/**,docs/**,**/*.sql,**/*.md}"
    }
  }
}
