# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ── Tickers ───────────────────────────────────────────────────────────────────
# The tracked universe now lives in universe.txt, which is committed to
# git so it is reviewable and travels with the repo. Uncomment below
# only to override it for a one-off run against a subset.
# TICKERS=NBIS,AAPL,MU,NVDA,GOOG,MDB,QCOM
HISTORICAL_DAYS=90

# ── AI Models ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key-here

# ── Data Provider ─────────────────────────────────────────────────────────────
# Options: yfinance (free, default) | polygon (production)
DATA_PROVIDER=yfinance

# Required only if DATA_PROVIDER=polygon
# Free key at https://polygon.io — covers EOD data
POLYGON_API_KEY=

# ── Smart Money (SEC EDGAR + OpenFIGI) ────────────────────────────────────────
# SEC asks every client to identify itself with a name and contact email,
# e.g. "Orblex Industries you@example.com". Works without it, but set it.
SEC_USER_AGENT=
# Optional — free key at https://www.openfigi.com/api raises the CUSIP→ticker
# rate limit from 250 to 2,500 lookups/min. Only matters on the first run.
OPENFIGI_API_KEY=

# ── Analyst horizon ───────────────────────────────────────────────────────────
# position — the original weeks-to-months analyst (valuation, 13F, macro)
# swing    — 1–10 trading day long-only trade plans with entry/stop/target,
#            validated in swing_policy.py. Apply swing_schema.sql first.
# In GitHub Actions, set the repository variable TRADING_MODE instead.
TRADING_MODE=position

# ── News (WSJ Premium) ────────────────────────────────────────────────────────
# Set true to inject WSJ headlines into Analyst Agent context
NEWS_ENABLED=false
WSJ_EMAIL=
WSJ_PASSWORD=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Run time in US/Eastern (pre-market — NYSE opens at 09:30)
SCHEDULER_RUN_TIME=08:30
# Set true to test scheduling without actually running the pipeline
SCHEDULER_DRY_RUN=false
