# The public demo build (npm run build:demo). These override .env, so the production database
# address and key never reach the demo bundle, and scripts/check_demo_bundle.mjs fails the build if
# they do. Nothing here is secret. Don't set VITE_SUPABASE_* on the demo's Vercel project: real
# environment variables outrank this file.
VITE_DEMO=1
VITE_SUPABASE_URL=https://demo.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=demo
VITE_REPO_URL=https://github.com/nakuljadeja08/orblex-industries
